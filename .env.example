# Copy to .env (or set in your host's dashboard) to override defaults.
# Every value below is optional — the app runs fine with none of them set.

# Network
PORT=3456
HOST=127.0.0.1          # use 0.0.0.0 when deploying behind a proxy / on a host

# Database (SQLite file; make it absolute when using a mounted volume)
DB_FILE=data/upsc.db

# Admin token for the Admin tab (x-admin-token header / login box)
ADMIN_TOKEN=local-admin-token

# Exam window timezone for the Sunday full-paper gate
TZ_WINDOW=Asia/Kolkata

# Selective-practice buffer (seconds added per question)
SELECTIVE_BUFFER_SECONDS=15
SSC_SELECTIVE_BUFFER_SECONDS=15

# PYQ year range shown in coverage / import
PYQ_START_YEAR=2007
PYQ_END_YEAR=2026
